# ---------- Site ----------
# URL publique HTTPS (en local : un tunnel type ngrok, car SumUp doit joindre le webhook)
SITE_URL=http://localhost:3000

# ---------- Supabase (SECRET : serveur uniquement, ne jamais préfixer par NEXT_PUBLIC_) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- SumUp (SECRET) ----------
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# Chaîne aléatoire longue ajoutée à l'URL du webhook (openssl rand -hex 24)
SUMUP_WEBHOOK_SECRET=

# ---------- E-mail (Resend) (SECRET) ----------
RESEND_API_KEY=
EMAIL_FROM=

# ---------- Espace administrateur ----------
ADMIN_EMAIL=admin@votre-domaine.com
# Généré avec : npm run hash-password -- "VotreMotDePasse"  (valeur en base64)
ADMIN_PASSWORD_HASH=
# openssl rand -base64 32
ADMIN_SESSION_SECRET=
